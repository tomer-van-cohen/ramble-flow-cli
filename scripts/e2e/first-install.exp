#!/usr/bin/expect -f
# Drives ./install.sh in a real pseudo-terminal, the way a person would: Enter for every default,
# the API key typed at the hidden prompt, and Full Disk Access "granted" halfway through (the test
# makes the synthetic recordings folder readable, then presses Enter to check again).
#
#   first-install.exp <repo> <api-key> <recordings-folder> <transcript-log>
set timeout 600
lassign $argv repo key recordings transcript
log_file -noappend $transcript
cd $repo
spawn ./install.sh

proc step {pattern answer} {
    expect {
        -re $pattern { send -- $answer }
        timeout { puts "\nE2E: timed out waiting for: $pattern"; exit 1 }
        eof { puts "\nE2E: installer ended while waiting for: $pattern"; exit 1 }
    }
}

step {Provider \[1\]: $} "\r"
step {API key \(typing is hidden\): $} "$key\r"
step {Folder \[~/Library/Group Containers/[^]]*\]: $} "\r"
step {Folder \[[^]]*Ramble Flow\]: $} "\r"
step {Language \[auto\]: $} "\r"
step {Model \[whisper-large-v3\]: $} "\r"
step {Apply these settings\? \[Y/n\]: $} "\r"
step {check again, or s to skip for now: $} ""
# The person switches on Full Disk Access in System Settings; here: make the folder readable.
exec chmod 755 $recordings
send "\r"
expect {
    -re {Done\. Transcripts} {}
    timeout { puts "\nE2E: no Done"; exit 1 }
}
expect eof
catch wait result
exit [lindex $result 3]
